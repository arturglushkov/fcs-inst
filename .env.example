# ─────────────────────────────────────────
#  MontazhBot — Environment Variables
# ─────────────────────────────────────────

# BOT
BOT_TOKEN=your_telegram_bot_token_here
BOT_WEBHOOK_URL=https://yourdomain.com/webhook
BOT_WEBHOOK_SECRET=your_random_secret_32chars

# DATABASE
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=montazh_bot
POSTGRES_USER=montazh
POSTGRES_PASSWORD=strongpassword123
DATABASE_URL=postgresql+asyncpg://montazh:strongpassword123@db:5432/montazh_bot

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:redis_password_here@redis:6379/0

# JWT
JWT_SECRET_KEY=your_super_secret_jwt_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ADMIN API
API_SECRET_KEY=your_api_secret_key
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=admin_password_here
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# S3 STORAGE (MinIO or AWS)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=montazh-photos
S3_PUBLIC_URL=https://s3.yourdomain.com

# AI (OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# GEO
GEO_CHECK_RADIUS_METERS=100
GEO_TRACKING_INTERVAL_MINUTES=15

# NOTIFICATIONS
NOTIFY_LATE_MINUTES=15          # опоздание через N минут
NOTIFY_OVERTIME_HOURS=9         # уведомление о переработке

# APP
APP_ENV=production              # development | production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Kiev

# RATE LIMITING
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ENCRYPTION
ENCRYPTION_KEY=your_fernet_encryption_key_here
